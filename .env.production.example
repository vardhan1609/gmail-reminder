# Copy to .env.production on the server. Never commit real secrets.
APP_DOMAIN=app.vuvg.in
API_DOMAIN=api.vuvg.in

POSTGRES_USER=gmail_user
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=gmail_reminder

# Application security
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=https://app.vuvg.in
CORS_ALLOWED_ORIGINS=["https://app.vuvg.in"]

# Google OAuth: register this exact redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.vuvg.in/auth/google/callback

# Gmail sync and notification preferences
POLL_INTERVAL_SECONDS=120
HISTORICAL_SYNC_DAYS=7
DRY_RUN=false
NOTIFICATION_MODE=immediate

# Select Meta Cloud API for production WhatsApp use, or webjs if you accept
# the operational and account-policy risks of an unofficial WhatsApp client.
WHATSAPP_PROVIDER=meta
WHATSAPP_SERVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_A_LONG_RANDOM_WEBHOOK_TOKEN

# Telegram is optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM provider credentials
LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
