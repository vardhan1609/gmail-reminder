FROM node:20-slim

# Puppeteer/Chromium dependencies (needed for webjs mode only, harmless if
# WHATSAPP_API_MODE=meta — just adds image size)
RUN apt-get update && apt-get install -y \
    chromium \
    fonts-liberation \
    libnss3 libatk-bridge2.0-0 libx11-xcb1 libxcomposite1 libxdamage1 \
    libxrandr2 libgbm1 libasound2 libpangocairo-1.0-0 libgtk-3-0 \
    --no-install-recommends && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Default to webjs; override with WHATSAPP_API_MODE=meta
ENV WHATSAPP_API_MODE=webjs

WORKDIR /app
COPY package.json .
RUN npm install --omit=dev

COPY src/ ./src/
COPY public/ ./public/

EXPOSE 3000
CMD ["node", "src/index.js"]
