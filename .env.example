# ═══════════════════════════════════════════════════════════════════
#  Gmail → WhatsApp + Telegram Notification System — Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit the .env file with real credentials.
# ═══════════════════════════════════════════════════════════════════

# ---- Google OAuth 2.0 ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ---- Database: SQLite or PostgreSQL ----
DATABASE_URL=sqlite:///./gmail_reminder.db
# For PostgreSQL: DATABASE_URL=postgresql://gmail_user:gmail_password@localhost:5432/gmail_reminder

# ---- Application & Security ----
SECRET_KEY=generate-a-secure-random-key-32-chars-minimum
API_KEY=generate-a-secure-api-key-here
SESSION_COOKIE_NAME=session_id
SESSION_EXPIRY_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MFA_ISSUER_NAME=GmailReminder
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=json
POLL_INTERVAL_SECONDS=120
HISTORICAL_SYNC_DAYS=7
DRY_RUN=false

# ---- Notification Mode ----
# Options: immediate, summary, important_only
NOTIFICATION_MODE=immediate
# Summary digest interval in minutes (used when NOTIFICATION_MODE=summary)
DIGEST_INTERVAL_MINUTES=60
# Privacy mode: sends only sender, subject, and Gmail link (no body)
PRIVACY_MODE=false
# Cutoff: emails older than this many hours won't trigger notifications
# (prevents notification storm on historical import)
NOTIFICATION_CUTOFF_HOURS=24

# ---- Gmail Sync ----
# Labels to include (comma-separated). Empty = INBOX only.
# Use ALL to process all labels except excluded ones.
GMAIL_INCLUDE_LABELS=INBOX
# Labels to exclude from notifications (comma-separated)
GMAIL_EXCLUDE_LABELS=SENT,SPAM,TRASH,DRAFT
# Set to true to process SENT, SPAM, TRASH folders
INCLUDE_SENT=false
INCLUDE_SPAM=false
INCLUDE_TRASH=false

# ---- Classification / LLM (optional) ----
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Reminder offsets (minutes before deadline), comma-separated ----
REMINDER_OFFSETS_MIN=1440,360,60

# ---- WhatsApp ----
WHATSAPP_PROVIDER=webjs
WHATSAPP_SERVICE_URL=http://localhost:3000
WHATSAPP_SERVICE_TOKEN=change-me-shared-secret
WHATSAPP_DESTINATION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-secret

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Outlook Calendar (optional) ----
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:8000/calendar/outlook/callback

