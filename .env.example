# ---- Gmail OAuth (shared app credentials; connect as many mailboxes ----
# ---- as you want at /accounts/gmail/login -- each gets its own token) ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/gmail/callback
TOKENS_DIR=tokens

# ---- App — MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=gmail_reminder
SECRET_KEY=generate-a-secure-random-key
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=120
GMAIL_QUERY=is:unread category:primary newer_than:7d

# ---- Classification / deadline extraction ----
# If set, LLM is used as a fallback for classification + deadline parsing.
# Leave empty to run in rule-based/regex-only mode.
# Choose provider: "anthropic", "openai", "gemini", or "ollama" (auto-detected if blank but keys exist)
LLM_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# OpenAI (or compatible: DeepSeek, OpenRouter, Groq, local APIs)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# ---- Reminder offsets (minutes before deadline), comma separated ----
REMINDER_OFFSETS_MIN=1440,360,60

# ---- WhatsApp API mode ----
# "webjs" = whatsapp-web.js bridge (unofficial, supports groups)
# "meta"  = Meta Cloud API (official, 1:1 messages only)
# If unset, the Node service shows an interactive menu on first run.
WHATSAPP_API_MODE=webjs

# ---- WhatsApp bridge (both modes use this Node service) ----
WHATSAPP_SERVICE_URL=http://localhost:3000
WHATSAPP_SERVICE_TOKEN=change-me-shared-secret

# ---- Meta Cloud API (only needed when WHATSAPP_API_MODE=meta) ----
# Get these from https://developers.facebook.com/ > your WhatsApp app
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-secret

# ---- Telegram bot (one bot token, posts to any group it's a member of) ----
# Create with @BotFather, add it to each group, then register groups as
# Destinations via POST /destinations.
TELEGRAM_BOT_TOKEN=

# ---- Outlook / Microsoft Graph calendar ----
# One shared calendar connection (see README for why this isn't per-Gmail-
# account). Register an app at https://portal.azure.com (Azure AD app
# registration), add http://localhost:8000/calendar/outlook/callback as a
# redirect URI, and grant Calendars.ReadWrite + User.Read delegated perms.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common
OUTLOOK_REDIRECT_URI=http://localhost:8000/calendar/outlook/callback
